{
  "name": "wmrm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --noEmit",
    "e2e": "npm run e2e:typecheck && playwright test",
    "e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "e2e:serve": "sh e2e/serve.sh"
  },
  "dependencies": {
    "pdfjs-dist": "5.4.624",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~5.9.2",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.13"
  }
}
